# Copy to .env.local and fill in. Never commit .env.local.

# Composio project API key (dashboard.composio.dev -> Platform -> project -> Getting Started)
COMPOSIO_API_KEY=
# Stable test user id for the hello-world / closed-loop scripts
COMPOSIO_TEST_USER_ID=

# Model provider: google | anthropic | openai
AI_PROVIDER=google
# Google AI Studio key (free tier). Only public docs + public probe results are ever sent to the model.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional, only if AI_PROVIDER is switched
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Public base URL (used for OG images, llms.txt, share links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

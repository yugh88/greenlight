// Regenerates data/guides/index.ts from the JSON files in data/guides (gold guides ship in the bundle).
import { readdirSync, writeFileSync } from "node:fs";
const files = readdirSync("data/guides").filter((f) => f.endsWith(".json")).sort();
const ids = files.map((f, i) => [`g${i}`, f] as const);
writeFileSync("data/guides/index.ts",
  `// AUTO-GENERATED by scripts/build-guide-index.mts. Do not edit.\nimport type { Guide } from "@/lib/schema";\n` +
  ids.map(([v, f]) => `import ${v} from "./${f}";`).join("\n") +
  `\n\nexport const goldGuides = [${ids.map(([v]) => v).join(", ")}] as unknown as Guide[];\n`);
console.log("indexed", files.length, "gold guides");
